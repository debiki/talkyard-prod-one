COMPOSE_PROJECT_NAME=talkyard-v1

# The registry and organization to download images from.
DOCKER_REG_ORG=debiki

# Which branch in the ./versions submodule to pull from to get the latest version number.
# Should be:  tyse-v1-regular  (there's also tyse-v1-dev and tyse-v0-*, but don't use).
RELEASE_BRANCH=tyse-v1-regular

# Which version of Talkyard to use.
# Don't edit manually; instead, scripts/upgrade-if-needed.sh sets it to the correct value.
VERSION_TAG=

# If you want to stop at a specific version, for some reason.
PINNED_VERSION_TAG=

#CDN_PULL_KEY=


# ----- Networks  [TYINTNET]

# Network segmentation, for security reasons.
#
# Give the Talkyard containers static ips, because applications or the OS seem
# to remember the containers ip addresses (even if Docker's DNS server return
# up-to-date ips) and requests then can fail to reach their destination,
# if a container gets restarted with a new dynamic ip.
#
# Let's use subnets 172.26.{1,2,3,4,5}.0/24.  (172.26.0.0 is the 172 subnet with
# the fewest Google web search hits — few people use it. Other nets result in
# 2 or 5 or 10 times more search engine hits.)

FE_PUB_NET_SUBNET=172.26.1.0/24
FE_INT_NET_SUBNET=172.26.2.0/24
BE_INT_NET_SUBNET=172.26.3.0/24
EG_INT_NET_SUBNET=172.26.4.0/24
EG_PUB_NET_SUBNET=172.26.5.0/24

TEST_INT_NET_SUBNET=172.26.8.0/24
TEST_PUB_NET_SUBNET=172.26.9.0/24
TEST_EXT_NET_SUBNET=203.0.113.0/24  # bogon range

# 1..19 is for Docker's gateway, and for Docker's DHCP server to use if needed.
# Docker's DHCP server seems to pick as low ip addresses as possible — so don't
# use 172.26.0. 2, 3, 4, 5 etc ourselves for static ips (because the containers
# would then fail to start, if Docker has used the ip for sth else, like
# a temporary test container we've started, already). Start at 21 instead.

# 21..29 for Nginx web servers.
FE_PUB_NET_WEB_IP=172.26.1.21
FE_INT_NET_WEB_IP=172.26.2.21

# 31..39 for app servers.
FE_INT_NET_APP_IP=172.26.2.31
BE_INT_NET_APP_IP=172.26.3.31
EG_INT_NET_APP_IP=172.26.4.31
TEST_INT_NET_APP_IP=172.27.8.31

# 41..49 for Deno renderer servers.
BE_INT_NET_RENDR_IP=172.26.3.41

# 51..59 for Redis cache servers.
BE_INT_NET_CACHE_IP=172.26.3.51

# 61..69 for database (PostgreSQL).
BE_INT_NET_RDB_IP=172.26.3.61
BE_INT_NET_RDB2_IP=172.26.3.62

# 71..79 for an ElasticSearch cluster.
BE_INT_NET_SEARCH_IP=172.26.3.71

# 101..109 for logging, analytics, tracing.
BE_INT_NET_TRACER_IP=172.26.3.81

# 99 is the egress proxy.
EG_INT_NET_EGRESSP_IP=172.26.4.99
EG_PUB_NET_EGRESSP_IP=172.26.5.99
# So can talk to fakeweb, when building & running tests.
TEST_EXT_NET_EGRESSP_IP=203.0.113.99

# 111..127 for e2e test containers, when building prod images.
TEST_INT_NET_FAKEMAIL_IP=172.26.8.112
TEST_PUB_NET_FAKEMAIL_IP=172.26.9.112

TEST_EXT_NET_FAKEWEB_IP=203.0.113.119

